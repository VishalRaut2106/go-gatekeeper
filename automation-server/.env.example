# ==============================================================================
# Gatekeeper npm Package Automation & Growth Monitoring Server Configuration
# ==============================================================================

# Server Network Settings
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Target npm Package to Monitor
NPM_PACKAGE_NAME=gatekeeper-shell
# Version to test: "latest" or specific semver like "2.1.2"
NPM_PACKAGE_VERSION=latest

# Admin Security & Authentication
# Required to trigger manual installation tests via POST /api/tests/run
ADMIN_API_KEY=gatekeeper-secret-key-change-me-in-production

# Worker & Installation Sandbox Settings
# Maximum duration (in milliseconds) before killing a stalled installation test
TEST_TIMEOUT_MS=90000
# Safe isolated directory for test workers (defaults to os.tmpdir() if empty)
TEST_TEMP_BASE_DIR=
# Concurrency limit for test workers (default 1 to prevent resource thrashing)
WORKER_CONCURRENCY_LIMIT=1

# Automated Schedule Settings (Cron Expressions)
# Run package installation test every 6 hours: "0 */6 * * *"
TEST_SCHEDULE_CRON="0 */6 * * *"
# Sync official npm download statistics every 3 hours: "0 */3 * * *"
ANALYTICS_SCHEDULE_CRON="0 */3 * * *"

# Database Configuration
# Supported: "sqlite" (default) or "postgres"
DB_TYPE=sqlite
# SQLite database file path (persisted across restarts)
SQLITE_DB_PATH=./data/gatekeeper_monitor.db
# PostgreSQL Connection URL (Used if DB_TYPE=postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/gatekeeper_monitor

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
